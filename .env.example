# Kopirajte u .env.local i popunite stvarnim vrednostima.
# Ovaj fajl sadrži isključivo imena promenljivih — nikada prave tajne.

# ---------------------------------------------------------------------------
# Baza (faza 1, obavezno)
# ---------------------------------------------------------------------------
# Postgres konekcija. Besplatan nivo kod Neon-a ili Supabase-a je dovoljan za start.
DATABASE_URL=postgres://korisnik:lozinka@host/baza?sslmode=require
# Broj konekcija u pool-u. Na Vercel-u držati nisko.
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Prijava (faza 1, obavezno)
# ---------------------------------------------------------------------------
# Nasumičan ključ za potpisivanje sesije: openssl rand -base64 32
AUTH_SECRET=
# Puna adresa aplikacije. Na Vercel-u se obično prepozna sama.
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Početni nalog (koristi ga samo `npm run db:seed`, jednom)
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Aleksandar Novković

# ---------------------------------------------------------------------------
# Razvoj
# ---------------------------------------------------------------------------
# Uključuje demo nizove iz fixtures/dev. NIKADA ne postavljati u produkciji.
PORTAL_DEV_FIXTURES=0

# ---------------------------------------------------------------------------
# Faza 2 — uvoz faktura iz BiznisSoft izvoza (još nije aktivno)
# ---------------------------------------------------------------------------
# Ključ kojim se lokalni konektor prijavljuje pri slanju fajlova.
INGEST_API_KEY=
FEATURE_FOLDER_CONNECTOR=0

# ---------------------------------------------------------------------------
# Faza 3 — BEX (još nije aktivno)
# ---------------------------------------------------------------------------
# Pristupni podaci se čuvaju isključivo na serveru i ne smeju u frontend kod.
BEX_CLIENT_ID=
BEX_API_KEY=
BEX_BASE_URL=
# 0 = isključeno, 1 = test okruženje/mock adapter, 2 = produkcija.
FEATURE_BEX=0

# --- Faza 1B: MFA i ograničavanje pokušaja ---------------------------------
# SAMO IMENA. Vrednosti se unose u okruženje servera i nikada u repozitorijum.
#
# Master ključ za šifrovanje TOTP tajni (base64, najmanje 32 bajta).
# Generisanje:  openssl rand -base64 32
PORTAL_MFA_MASTER_KEY_V1=
# Koja verzija ključa se koristi za NOVE zapise. Stari zapisi ostaju čitljivi
# svojom verzijom, pa rotacija ne traži prepisivanje baze.
PORTAL_MFA_ACTIVE_KEY_VERSION=1
# Ključ za pseudonimizaciju u tabeli brojača (base64, najmanje 32 bajta).
# Odvojen od MFA ključa: ovaj sloj ne dodiruje tajne naloga.
AUTH_RATE_LIMIT_HMAC_KEY=
# off | enroll | enforced — prelazi se RUČNO, nikad iz koda ili migracije.
#
#   off       pun pristup lozinkom, ali SAMO van produkcije. U produkciji i
#             `off` daje samo vezivanje: sistem ne vidi razliku između
#             „vlasnik je svesno izabrao off" i „promenljiva je ispala".
#   enroll    prijava lozinkom prolazi, ali vodi isključivo na vezivanje.
#   enforced  bez aktivnog faktora treba važeća dozvola; bez nje prijava pada.
#
# NEDOSTAJUĆA ili neispravna vrednost u produkciji NE postaje `off` nego
# `enforced`. Van produkcije postaje `off`. Vidi lib/auth/mfa-policy.mjs.
PORTAL_MFA_MODE=off
# Zastarelo ime, i dalje se čita ako `PORTAL_MFA_MODE` nije podešen.
# PORTAL_MFA_ENFORCEMENT=off
# Nalog sa pravom na DDL; koristi se ISKLJUČIVO za migracije, nikad iz runtime-a.
MIGRATION_DATABASE_URL=
