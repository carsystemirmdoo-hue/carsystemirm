{
  "_comment": [
      "Mapiranje ULOGE R-M proizvoda u postojeću taksonomiju sajta. Pravila se čitaju redom; prvo koje odgovara pobeđuje.",
      "`role` je uloga iz tehničke kategorije info portala; `when` su dodatni uslovi iz zvaničnih činjenica:",
      "  aerosol      → opis/TDS kaže „aerosol”",
      "  usedByRole   → uloga proizvoda koji ovu komponentu navode u svom TDS-u (učvršćivač kita ide uz kitove, ne uz lakove)",
      "  textMatches  → regex nad opisom portala i TDS primenom"
  ],
  "rules": [
    {"id": "aerosol-undercoat", "role": "undercoat", "when": {"aerosol": true}, "category": "sprejevi", "programSlug": "aerosoli", "phaseSlug": "podloga", "visualType": "spray"},
    {"id": "aerosol", "when": {"aerosol": true}, "category": "sprejevi", "programSlug": "aerosoli", "phaseSlug": "lak", "visualType": "spray"},
    {"id": "cleaner", "role": "cleaner", "category": "ciscenje", "programSlug": "priprema-povrsine", "phaseSlug": "priprema", "visualType": "neutral"},
    {"id": "bodyfiller", "role": "bodyfiller", "category": "kitovi", "programSlug": "priprema-povrsine", "phaseSlug": "priprema", "visualType": "filler"},
    {"id": "bodyfiller-hardener", "role": "hardener", "when": {"textMatches": "body filler"}, "category": "kitovi", "programSlug": "priprema-povrsine", "phaseSlug": "priprema", "visualType": "filler"},
    {"id": "undercoat", "role": "undercoat", "category": "boje", "programSlug": "boje-i-lakovi", "phaseSlug": "podloga", "visualType": "primer"},
    {"id": "clearcoat", "role": "clearcoat", "category": "boje", "programSlug": "boje-i-lakovi", "phaseSlug": "lak", "visualType": "clearcoat"},
    {"id": "basecoat", "role": "basecoat-topcoat", "category": "boje", "programSlug": "boje-i-lakovi", "phaseSlug": "boja", "visualType": "color"},
    {"id": "component-undercoat", "when": {"usedByRole": "undercoat"}, "category": "boje", "programSlug": "boje-i-lakovi", "phaseSlug": "podloga", "visualType": "primer"},
    {"id": "component-basecoat", "when": {"usedByRole": "basecoat-topcoat"}, "category": "boje", "programSlug": "boje-i-lakovi", "phaseSlug": "boja", "visualType": "color"},
    {"id": "component-clearcoat", "when": {"usedByRole": "clearcoat"}, "category": "boje", "programSlug": "boje-i-lakovi", "phaseSlug": "lak", "visualType": "clearcoat"},
    {"id": "hardener", "role": "hardener", "category": "boje", "programSlug": "boje-i-lakovi", "phaseSlug": "lak", "visualType": "clearcoat"},
    {"id": "thinner", "role": "thinner", "category": "boje", "programSlug": "boje-i-lakovi", "phaseSlug": "lak", "visualType": "clearcoat"},
    {"id": "additive", "role": "additive", "category": "boje", "programSlug": "boje-i-lakovi", "phaseSlug": "lak", "visualType": "clearcoat"}
  ]
}
