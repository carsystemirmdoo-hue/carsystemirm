# Kopirajte u .env.local i popunite stvarnim vrednostima.
# Ovaj fajl sadrži isključivo imena promenljivih — nikada prave tajne.

# ---------------------------------------------------------------------------
# Baza (faza 1, obavezno)
# ---------------------------------------------------------------------------
# Postgres konekcija. Besplatan nivo kod Neon-a ili Supabase-a je dovoljan za start.
DATABASE_URL=postgres://korisnik:lozinka@host/baza?sslmode=require
# Broj konekcija u pool-u. Na Vercel-u držati nisko.
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Prijava (faza 1, obavezno)
# ---------------------------------------------------------------------------
# Nasumičan ključ za potpisivanje sesije: openssl rand -base64 32
AUTH_SECRET=
# Puna adresa aplikacije. Na Vercel-u se obično prepozna sama.
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Početni nalog (koristi ga samo `npm run db:seed`, jednom)
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Aleksandar Novković

# ---------------------------------------------------------------------------
# Razvoj
# ---------------------------------------------------------------------------
# Uključuje demo nizove iz fixtures/dev. NIKADA ne postavljati u produkciji.
PORTAL_DEV_FIXTURES=0

# ---------------------------------------------------------------------------
# Faza 2 — uvoz faktura iz BiznisSoft izvoza (još nije aktivno)
# ---------------------------------------------------------------------------
# Ključ kojim se lokalni konektor prijavljuje pri slanju fajlova.
INGEST_API_KEY=
FEATURE_FOLDER_CONNECTOR=0

# ---------------------------------------------------------------------------
# Faza 3 — BEX (još nije aktivno)
# ---------------------------------------------------------------------------
# Pristupni podaci se čuvaju isključivo na serveru i ne smeju u frontend kod.
BEX_CLIENT_ID=
BEX_API_KEY=
BEX_BASE_URL=
# 0 = isključeno, 1 = test okruženje/mock adapter, 2 = produkcija.
FEATURE_BEX=0
