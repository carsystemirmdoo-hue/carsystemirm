# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example sadrži samo imena promenljivih, bez vrednosti — mora u repozitorijum.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local/dev artifacts
node_modules
.next
out
*.zip
.DS_Store

# local AI/tooling state
.claude/

# private location imports and generated internal review artifacts
/_incoming/*.csv
/data/internal/location-import-review.csv
/data/internal/location-import-summary.json
/data/internal/geocoding-cache.json

# Local generated and review artifacts
tmp/
review-screenshots/
docs/audit-screenshots/

# Local QA screenshots and reports
artifacts/

# Manufacturer assets staged for review (not published)
assets/manufacturer/
.cache/

# izlaz provere builda (npm run build:check)
.next-verify

# izolovani izlaz dev servera (npm run dev)
.next-dev

# izolovani izlaz dev servera za search QA (paralelni Next proces ne sme deliti dist)
.next-search-dev
