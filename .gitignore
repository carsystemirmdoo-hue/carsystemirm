# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example sadrži samo imena promenljivih, bez vrednosti — mora u repozitorijum.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local/dev artifacts
node_modules
.next
out
*.zip
.DS_Store

# local AI/tooling state
.claude/

# private location imports and generated internal review artifacts
/_incoming/*.csv
# Radne liste registra partnera: adrese e-pošte i telefoni iz izvora (scripts/partners).
/_incoming/partners/
/_incoming/*.xlsx
/data/internal/location-import-review.csv
/data/internal/location-import-summary.json
/data/internal/geocoding-cache.json

# Local generated and review artifacts
tmp/
review-screenshots/
docs/audit-screenshots/
docs/visual-evidence/

# Local QA screenshots and reports
artifacts/

# Manufacturer assets staged for review (not published)
assets/manufacturer/
.cache/

# izlaz provere builda (npm run build:check)
.next-verify
.next-pilot

# izolovani izlaz dev servera (npm run dev)
.next-dev

# izolovani izlaz dev servera za search QA (paralelni Next proces ne sme deliti dist)
.next-search-dev

# Local content-asset intake
/_incoming/assets/
._*
__MACOSX/

# Spakovan konektor — artefakt builda, ne izvor.
connector/dist/

# Generated by npm run seo:audit
/docs/seo/SEO_IMAGE_AUDIT.csv
/docs/seo/SEO_CANONICAL_MAP.csv

# Slike bez potvrđenog prava objave: izvor je review-assets/pending-rights/, kopija u public/ nastaje samo za lokalni/Preview build
public/products/*/pending-rights/
