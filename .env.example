# Kopirajte u .env.local i popunite stvarnim vrednostima.
# Ovaj fajl sadrži isključivo imena promenljivih — nikada prave tajne.

# ---------------------------------------------------------------------------
# Baza (faza 1, obavezno)
# ---------------------------------------------------------------------------
# Postgres konekcija. Besplatan nivo kod Neon-a ili Supabase-a je dovoljan za start.
DATABASE_URL=postgres://korisnik:lozinka@host/baza?sslmode=require
# Broj konekcija u pool-u. Na Vercel-u držati nisko.
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Prijava (faza 1, obavezno)
# ---------------------------------------------------------------------------
# Nasumičan ključ za potpisivanje sesije: openssl rand -base64 32
AUTH_SECRET=
# Puna adresa aplikacije. Na Vercel-u se obično prepozna sama.
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Početni nalog (koristi ga samo `npm run db:seed`, jednom)
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Aleksandar Novković

# ---------------------------------------------------------------------------
# Razvoj
# ---------------------------------------------------------------------------
# Uključuje demo nizove iz fixtures/dev. NIKADA ne postavljati u produkciji.
PORTAL_DEV_FIXTURES=0

# ---------------------------------------------------------------------------
# Prijem sa uređaja (P2) — PODRAZUMEVANO ISKLJUČEN
# ---------------------------------------------------------------------------
# Jedini prekidač za `/api/sync/ingest` i `/api/sync/heartbeat`.
# Traži se doslovno "1". Sve ostalo — "0", "false", prazno, izostavljeno —
# znači isključeno, i obe rute vraćaju 404.
#
# Uređaji se autentifikuju ASIMETRIČNIM potpisom (Ed25519): privatni ključ
# nastaje i ostaje na uređaju, server čuva samo javni. Nema deljene tajne,
# pa ovde nema ni ključa koji bi se podesio.
FEATURE_SYNC_DEVICE_INGEST=0

# ---------------------------------------------------------------------------
# Ručne komande konektoru (P4) — PODRAZUMEVANO ISKLJUČENE
# ---------------------------------------------------------------------------
# Prekidač za `/api/sync/commands/poll` i `/api/sync/commands/update`, i za
# dugme „Skeniraj i sinhronizuj“ u portalu. Traži se doslovno "1".
#
# ZASEBAN je od prijema iznad, i TRAŽI ga: uključivanje prijema dokumenata ne
# sme usput da otvori i daljinsko pokretanje posla na kancelarijskom računaru,
# a komanda bez prijema bi pokrenula ciklus koji ne sme ništa da pošalje.
#
# Komanda ne nosi nijedan parametar: tip je zatvoren (`scan_and_sync`), a
# folder, raspored i identitet ostaju u lokalnoj konfiguraciji konektora.
# Termin u 09:00 ne zavisi od ovog prekidača.
FEATURE_SYNC_OPERATIONS=0

# ---------------------------------------------------------------------------
# Preporuke (cadence_v1) — PODRAZUMEVANO ISKLJUČENE
# ---------------------------------------------------------------------------
# Prekidač za interni ekran „Prodaja → Preporuke“ i za ručno preračunavanje.
# Traži se doslovno "1".
#
# Nezavisan je od sinhronizacije: uvoz istorije NE SME usput da uključi
# preporuke. Dok je isključen, ekran postojeće rezultate i dalje prikazuje, ali
# se novo preračunavanje odbija i u akciji, ne samo u prikazu.
#
# Šta ovaj prekidač NE kontroliše, jer to ne postoji ni kada je uključen:
# kupčev pogled na preporuke, automatsko slanje poruke kupcu, automatsku
# porudžbinu i automatski recompute posle svakog dokumenta. To su funkcije koje
# V1 NEMA — a nepostojeća funkcija se ne uključuje prekidačem.
FEATURE_RECOMMENDATIONS=0

# ---------------------------------------------------------------------------
# NAPUŠTENO — raniji nacrt konektora sa deljenim ključem
# ---------------------------------------------------------------------------
# Ove dve promenljive nikada nisu bile upotrebljene u kodu i ostaju prazne.
# Zamenjuje ih `FEATURE_SYNC_DEVICE_INGEST` iznad, uz asimetričan potpis;
# HMAC/deljeni ključ iz `docs/b2b/04` NIJE odobrena zamena.
INGEST_API_KEY=
FEATURE_FOLDER_CONNECTOR=0

# ---------------------------------------------------------------------------
# Portal korpa (lista za upit) — ISKLJUČENA po podrazumevanoj vrednosti
# ---------------------------------------------------------------------------
# Uključuje korpu u portalu. Korpa je lista proizvoda za upit: nema cene, nema
# ukupnog iznosa, nema checkouta i ne kreira porudžbinu. Čuva se isključivo u
# pretraživaču, pod ključem vezanim za UUID prijavljenog korisnika.
#
# Pored ovog flag-a traži se i sposobnost `customer_orders:create`, koju danas
# nosi samo uloga `gazda`. Customer/tenant model još ne postoji, pa je korpa
# namerno zatvorena: uključuje se svesno, po instalaciji.
#
# OGRANIČENJE: zapis u pretraživaču nije bezbednosna granica. Ključ nosi pun
# UUID korisnika, što praktično uklanja rizik sudara namespace-a, ali UUID je
# pseudonimni identifikator poveziv sa nalogom i sadržaj je čitljiv svakome ko
# ima pristup profilu pretraživača na tom računaru. Ovo nije zamena za buduću
# serversku korpu po korisniku/tenantu.
#
# Prihvaćene vrednosti za uključivanje: 1, true, yes, on. Sve ostalo je off.
PORTAL_COMMERCE=off

# ---------------------------------------------------------------------------
# Faza 3 — BEX (još nije aktivno)
# ---------------------------------------------------------------------------
# Pristupni podaci se čuvaju isključivo na serveru i ne smeju u frontend kod.
BEX_CLIENT_ID=
BEX_API_KEY=
BEX_BASE_URL=
# 0 = isključeno, 1 = test okruženje/mock adapter, 2 = produkcija.
FEATURE_BEX=0

# --- Faza 1B: MFA i ograničavanje pokušaja ---------------------------------
# SAMO IMENA. Vrednosti se unose u okruženje servera i nikada u repozitorijum.
#
# Master ključ za šifrovanje TOTP tajni (base64, najmanje 32 bajta).
# Generisanje:  openssl rand -base64 32
PORTAL_MFA_MASTER_KEY_V1=
# Koja verzija ključa se koristi za NOVE zapise. Stari zapisi ostaju čitljivi
# svojom verzijom, pa rotacija ne traži prepisivanje baze.
PORTAL_MFA_ACTIVE_KEY_VERSION=1
# Ključ za pseudonimizaciju u tabeli brojača (base64, najmanje 32 bajta).
# Odvojen od MFA ključa: ovaj sloj ne dodiruje tajne naloga.
#
# U PRODUKCIJI JE OBAVEZAN. Odsutan, prazan ili prekratak ključ ne isključuje
# tiho ograničavanje pokušaja — prijava, TOTP, reset lozinke, aktivacija i
# bezbednosne radnje (uklj. otvaranje naloga sa ulogom „gazda") se tada ODBIJAJU
# dok se ključ ne podesi. Van produkcije (lokalni razvoj, testovi) odsustvo
# ključa i dalje samo isključuje ograničavanje, kao i do sada.
AUTH_RATE_LIMIT_HMAC_KEY=
# off | enroll | enforced — prelazi se RUČNO, nikad iz koda ili migracije.
#
#   off       pun pristup lozinkom, ali SAMO van produkcije. U produkciji i
#             `off` daje samo vezivanje: sistem ne vidi razliku između
#             „vlasnik je svesno izabrao off" i „promenljiva je ispala".
#   enroll    prijava lozinkom prolazi, ali vodi isključivo na vezivanje.
#   enforced  bez aktivnog faktora treba važeća dozvola; bez nje prijava pada.
#
# NEDOSTAJUĆA ili neispravna vrednost NA SVAKOM UDALJENOM DEPLOYMENT-U (Vercel
# Production, Preview, ili bilo koja druga neprazna VERCEL_ENV vrednost) NE
# postaje `off` nego `enforced`. Isto važi i za EKSPLICITNI `off` na tim
# deployment-ima — tretira se kao nevalidna konfiguracija i odbija prijavu, bez
# obzira na to da li je master ključ podešen: sistem ne može da razlikuje
# „vlasnik je svesno isključio MFA na Preview-u" od „promenljiva je procurela
# kopiranjem lokalnog .env-a". Samo van svakog udaljenog deployment-a (lokalni
# razvoj, testovi, ili `vercel dev`) `off` — eksplicitan ili podrazumevan —
# stvarno isključuje MFA. Vidi lib/auth/mfa-policy.mjs (`requiresEnforcedMfa`).
PORTAL_MFA_MODE=off
# Zastarelo ime, i dalje se čita ako `PORTAL_MFA_MODE` nije podešen.
# PORTAL_MFA_ENFORCEMENT=off
# Nalog sa pravom na DDL; koristi se ISKLJUČIVO za migracije, nikad iz runtime-a.
MIGRATION_DATABASE_URL=
